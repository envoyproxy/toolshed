load("@rules_cc//cc/toolchains:cc_toolchain.bzl", "cc_toolchain")
load(":toolchain.bzl", "gcc_linux_cc_toolchain_config")

package(default_visibility = ["//visibility:public"])

filegroup(
    name = "empty",
    srcs = [],
)

gcc_linux_cc_toolchain_config(
    name = "linux_x64_config",
    arch = "x86_64",
)

cc_toolchain(
    name = "linux_x64",
    all_files = ":empty",
    ar_files = ":empty",
    compiler_files = ":empty",
    dwp_files = ":empty",
    linker_files = ":empty",
    objcopy_files = ":empty",
    strip_files = ":empty",
    toolchain_config = ":linux_x64_config",
)

# Selection is driven by the target platform: target_compatible_with
# //compile:libstdcxx means gcc is only a candidate for platforms that ask for
# libstdc++ (ie //platforms:linux_x86_64_libstdcxx and the wee8 transition).
#
# Placement is driven by execution platform ORDER, not by an exec constraint.
# Bazel tie-breaks between two compatible toolchains by taking the first
# execution platform in --extra_execution_platforms that yields a toolchain, so
# the gcc platforms are listed first in .bazelrc and gcc claims
# //platforms/rbe:linux_x64_gcc before clang can.
#
# There is deliberately no //compile:gcc_worker here. Requiring it meant gcc
# matched no exec platform when building without RBE (the only exec platform is
# @platforms//host, which carries the //compile:worker default of
# :llvm_worker), and it also stranded host tooling under --config=rbe-gcc.
# //compile:llvm_worker is still required by the llvm toolchains, which is what
# prevents clang being scheduled into the gcc container.
#
# NB: the cc_toolchain has empty filegroups and invokes /usr/bin/gcc from the
# exec machine, so it only works where gcc is actually installed - on RBE that
# is guaranteed by the ordering above rather than by a constraint.
toolchain(
    name = "linux_x64_toolchain",
    exec_compatible_with = [
        "@platforms//os:linux",
        "@platforms//cpu:x86_64",
    ],
    target_compatible_with = [
        "@platforms//os:linux",
        "@platforms//cpu:x86_64",
        "//compile:libstdcxx",
    ],
    toolchain = ":linux_x64",
    toolchain_type = "@bazel_tools//tools/cpp:toolchain_type",
)

gcc_linux_cc_toolchain_config(
    name = "linux_arm64_config",
    arch = "aarch64",
)

cc_toolchain(
    name = "linux_arm64",
    all_files = ":empty",
    ar_files = ":empty",
    compiler_files = ":empty",
    dwp_files = ":empty",
    linker_files = ":empty",
    objcopy_files = ":empty",
    strip_files = ":empty",
    toolchain_config = ":linux_arm64_config",
)

toolchain(
    name = "linux_arm64_toolchain",
    exec_compatible_with = [
        "@platforms//os:linux",
        "@platforms//cpu:aarch64",
    ],
    target_compatible_with = [
        "@platforms//os:linux",
        "@platforms//cpu:aarch64",
        "//compile:libstdcxx",
    ],
    toolchain = ":linux_arm64",
    toolchain_type = "@bazel_tools//tools/cpp:toolchain_type",
)
