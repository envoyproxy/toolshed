
#############################################################################
# global
#############################################################################

fetch --color=yes
run --color=yes
build --color=yes

common --enable_bzlmod
common --noenable_workspace
common --legacy_external_runfiles
common --repo_env=BAZEL_DO_NOT_DETECT_CPP_TOOLCHAIN=1
common --@rules_python//python/config_settings:bootstrap_impl=script

common --registry=https://bcr.bazel.build/
common --registry=https://raw.githubusercontent.com/envoyproxy/bazel-registry/76440e57c1495e6e6b26e30069d42050a8ca5acb
common --experimental_repository_cache_hardlinks

common --repo_env=ANDROID_HOME=


#############################################################################
# ci
#############################################################################

common:ci --noshow_progress
common:ci --noshow_loading_progress
common:ci --test_output=errors


#############################################################################
# rbe (engflow)
#############################################################################

common:bes --bes_backend=grpcs://mordenite.cluster.engflow.com/
common:bes --bes_results_url=https://mordenite.cluster.engflow.com/invocation/
common:bes --bes_timeout=3600s
common:bes --bes_upload_mode=fully_async
common:bes --nolegacy_important_outputs

common:engflow-common --google_default_credentials=false
common:engflow-common --credential_helper=*.engflow.com=%workspace%/engflow-bazel-credential-helper.sh
common:engflow-common --grpc_keepalive_time=60s
common:engflow-common --grpc_keepalive_timeout=30s
common:engflow-common --remote_cache_compression
common:engflow-common --remote_retries=10
common:engflow-common --remote_retry_max_delay=60s
common:engflow-common --experimental_remote_cache_eviction_retries=5

common:rbe --config=remote-cache
common:rbe --config=remote-exec

# Retained for explicit gcc-only RBE invocations.
#
# This deliberately does NOT set --host_platform. Host/exec-config targets (eg
# //website/tools/pelican) must keep building with llvm on the general purpose
# worker; pointing --host_platform at the gcc container made it the *target*
# platform for those targets, where gcc does not match (no //compile:libstdcxx)
# and clang cannot be scheduled (the platform carries //compile:gcc_worker),
# giving "Unable to find a CC toolchain".
#
# :remote-exec already registers the gcc worker platforms, so gcc actions reach
# the gcc container without any override here.
common:rbe-gcc --config=rbe

# Remote cache + BES only (no remote execution); suitable for macOS builds.
common:rbe-cache-only --config=remote-cache
common:rbe-cache-only --config=bes

common:remote-cache --config=engflow-common
common:remote-cache --remote_cache=grpcs://mordenite.cluster.engflow.com
common:remote-cache --experimental_remote_downloader=grpcs://mordenite.cluster.engflow.com
common:remote-cache --remote_timeout=3600s

common:remote-exec --remote_executor=grpcs://mordenite.cluster.engflow.com
common:remote-exec --jobs=200
common:remote-exec --define=engflow_rbe=true
# Platforms carry the `container-image` exec property that EngFlow's
# WorkerInDockerActionRunner matches on; without these registered, dispatched
# actions fail with `No matching action runner found`.
#
# ORDER IS LOAD-BEARING. When both gcc and clang are compatible with a target
# platform, Bazel breaks the tie by taking the first execution platform in this
# list that yields a toolchain - not by toolchain registration order. The gcc
# platforms must therefore come first, or clang claims //platforms/rbe:linux_x64
# and silently produces a libc++ build under a -libstdcxx name.
#
# This is safe for ordinary (libcxx) targets: gcc requires //compile:libstdcxx
# on the target platform, so it is not a candidate at all, and the gcc platforms
# yield no toolchain and are skipped.
common:remote-exec --host_platform=//platforms/rbe:linux_x64
common:remote-exec --extra_execution_platforms=//platforms/rbe:linux_x64_gcc,//platforms/rbe:linux_arm64_gcc,//platforms/rbe:linux_x64,//platforms/rbe:linux_arm64

#############################################################################
# gcc
#############################################################################

common:gcc --//compile:use_gcc_toolchain=true
common:gcc --platforms=//platforms:linux_x86_64_libstdcxx

#############################################################################
# macos
#############################################################################

common:macos --repo_env=BAZEL_DO_NOT_DETECT_CPP_TOOLCHAIN=0


#############################################################################
# imports
#############################################################################

try-import %workspace%/repo.bazelrc
try-import %workspace%/user.bazelrc
