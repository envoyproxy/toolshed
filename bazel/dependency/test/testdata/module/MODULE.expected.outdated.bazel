module(
    name = "module_updater_test",
    version = "0.1.0",
)

bazel_dep(
    name = "bazel_skylib",
    version = "1.9.0",
)
bazel_dep(name = "protobuf", version = "35.2.bcr.envoy", repo_name = "com_google_protobuf")

bazel_dep(name = "sq", version = "1.5.0.envoy", dev_dependency = True)

bazel_dep(name = "sq_jq", version = "1.4.0.envoy")

single_version_override(
    module_name = "bazel_skylib",
    version = "1.9.0",
)

single_version_override(
    module_name = "sq_jq",
    version = "1.4.0.envoy",
)

