# Binary exercising std::string/std::vector so that the resulting object
# carries standard library symbols in the toolchain's inline namespace.
cc_binary(
    name = "test_stdlib",
    srcs = ["test_stdlib.cc"],
    copts = ["-Werror"],
)

# Standard library ABI assertions.
#
# These check which C++ standard library was *actually* linked, rather than
# which one the build claims to have selected. libstdc++ emits symbols in the
# __cxx11 inline namespace; libc++ uses std::__1. A silent toolchain fallback
# — the failure mode that motivated these tests — shows up here as the wrong
# namespace, where every other signal (build success, artifact name, even file
# size) looks correct.
#
# Note these are gated the *inverse* way from the unwind tests above: the
# libstdcxx variant only runs when :gcc_build is set, and vice versa. Every
# other binary-inspecting test in this package is disabled under gcc, which is
# why the gcc leg had no output verification at all.
#
# Run with:
#   bazel test //compile/test:stdlib_libstdcxx_test --config=gcc
sh_test(
    name = "stdlib_libstdcxx_test",
    size = "small",
    srcs = ["check_stdlib.sh"],
    data = [":test_stdlib"],
    env = {
        "BINARY": "$(rootpath :test_stdlib)",
        "EXPECTED_STDLIB": "libstdcxx",
    },
    tags = ["manual"],
    target_compatible_with = select({
        "//compile:gcc_build": [],
        "//conditions:default": ["@platforms//:incompatible"],
    }),
)

# Run with:
#   bazel test //compile/test:stdlib_libcxx_test
sh_test(
    name = "stdlib_libcxx_test",
    size = "small",
    srcs = ["check_stdlib.sh"],
    data = [":test_stdlib"],
    env = {
        "BINARY": "$(rootpath :test_stdlib)",
        "EXPECTED_STDLIB": "libcxx",
    },
    tags = ["manual"],
    target_compatible_with = select({
        "//compile:gcc_build": ["@platforms//:incompatible"],
        "//compile:macos_build": ["@platforms//:incompatible"],
        "//conditions:default": [],
    }),
)
