# Unlike archive symbol-name filtering, this link resolves wee8's libc references
# against the base sysroot and produces an ELF with actual GLIBC version tags.
cc_binary(
    name = "wee8_link_probe",
    srcs = ["wee8_link_probe.cc"],
    tags = ["manual"],
    target_compatible_with = _WEE8_LINK_COMPATIBLE,
    deps = ["//v8:wee8"],
)

