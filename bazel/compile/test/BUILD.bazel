# TODO: remove the hash gate after the next bins release rebuilds libstdcxx wee8.
# This published prebuilt used host glibc 2.39; changing its hash activates CI.
_WEE8_LINK_COMPATIBLE = select({
    "//compile:gcc_build": [],
    "//conditions:default": ["@platforms//:incompatible"],
}) if VERSIONS["wee8_sha256"]["x86_64"]["libstdcxx"] not in [
    "",
    "ad9895c550bdf8f4de931c0143c99cc28ae38aa0b475bc4602e494eedac46e90",
] else ["@platforms//:incompatible"]

