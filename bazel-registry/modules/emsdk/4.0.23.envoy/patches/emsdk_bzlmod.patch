diff --git a/bazel/emscripten_toolchain/env.sh b/bazel/emscripten_toolchain/env.sh
index 1111111..2222222 100755
--- a/bazel/emscripten_toolchain/env.sh
+++ b/bazel/emscripten_toolchain/env.sh
@@ -4,2 +4,19 @@ export ROOT_DIR=${EXT_BUILD_ROOT:-$(pwd -P)}
 export EMSCRIPTEN=$ROOT_DIR/$EM_BIN_PATH/emscripten
 export EM_CONFIG=$ROOT_DIR/$EM_CONFIG_PATH
+
+# Resolve the hermetic Python interpreter provided by rules_python's Python 3.12
+# toolchain (added to the toolchain files via `@python_3_12//:files`) from the
+# execroot at runtime. Globbing avoids hardcoding a repository path that bakes in
+# the Bazel canonical-repo separator (`~~` vs `++`/`+`), the Python minor/patch
+# version or the host architecture, so it stays robust across Bazel versions and
+# platforms. Falls back to the system `python3` if no hermetic interpreter is
+# found.
+if [ -z "${EM_PYTHON3:-}" ]; then
+    for _em_python3 in "$ROOT_DIR"/external/*python*3_12*/bin/python3; do
+        if [ -x "$_em_python3" ]; then
+            EM_PYTHON3="$_em_python3"
+            break
+        fi
+    done
+fi
+export EM_PYTHON3="${EM_PYTHON3:-python3}"
