--- a/toolchain/cc_wrapper.sh.tpl
+++ b/toolchain/cc_wrapper.sh.tpl
@@ -85,6 +85,14 @@
   toolchain_path_prefix="$(dirname_shim "$(dirname_shim "${script_dir}")")/${toolchain_path_prefix#external/}"
 fi
 
+# Absolute exec-root, so exec-root-relative -imacros paths (redacted_dates.h,
+# injected by toolchains_llvm's unfiltered_compile_flags) resolve even when the
+# action's cwd is not the exec root (e.g. rules_rust CargoBuildScriptRun).
+exec_root_abs=""
+if [[ ${toolchain_path_prefix} != /* ]] && [[ "${script_dir}" == "/"* ]]; then
+  exec_root_abs="$(dirname_shim "$(dirname_shim "$(dirname_shim "${script_dir}")")")"
+fi
+
 if [[ ! -f ${toolchain_path_prefix}bin/clang ]]; then
   echo >&2 "ERROR: could not find clang; PWD=\"${PWD}\"; PATH=\"${PATH}\"; toolchain_path_prefix=${toolchain_path_prefix}."
   exit 5
@@ -111,6 +119,8 @@
     parts=(${opt/=/ }) # Split flag name and value into array.
     # shellcheck disable=SC2312
     printf "%s" "${parts[0]}=$(dirname_shim "$(dirname_shim "$(dirname_shim "${script_dir}")")")/${parts[1]}"
+  elif [[ ${opt} =~ ^external/[^/]+/redacted_dates\.h$ ]] && [[ -n "${exec_root_abs}" ]]; then
+    printf "%s" "${exec_root_abs}/${opt}"
   else
     printf "%s" "${opt}"
   fi
