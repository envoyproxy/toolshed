load("@rules_cc//cc:defs.bzl", "cc_library")

_LLVM_OBJCOPY = "@@toolchains_llvm++llvm+llvm_toolchain//:bin/llvm-objcopy"

_CMD = """
    cp "$<" "$(RULEDIR)/icudt78_dat.bin"
    ROOT="$$PWD"
    cd "$(RULEDIR)"
    "$$ROOT/$(execpath {objcopy})" \
        -I binary -O {fmt} \
        --rename-section .data=.rodata,alloc,load,readonly,data,contents \
        --redefine-sym _binary_icudt78_dat_bin_start=icudt78_dat \
        icudt78_dat.bin \
        "$$ROOT/$@"
"""

genrule(
    name = "icudata_obj",
    srcs = ["source/data/in/icudt78l.dat"],
    outs = ["icudt78_dat.o"],
    cmd = select({
        "@platforms//cpu:aarch64": _CMD.format(objcopy = _LLVM_OBJCOPY, fmt = "elf64-littleaarch64"),
        "//conditions:default": _CMD.format(objcopy = _LLVM_OBJCOPY, fmt = "elf64-x86-64"),
    }),
    tools = [_LLVM_OBJCOPY],
)

cc_library(
    name = "icudata",
    srcs = [":icudata_obj"],
    alwayslink = 1,
    visibility = ["//visibility:public"],
)

cc_library(
    name = "icu",
    visibility = ["//visibility:public"],
    deps = [
        ":icudata",
        "//source/common:platform",
    ],
)
