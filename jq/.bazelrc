#############################################################################
# CI never drives Bazel from `jq/` directly - `jq/`'s targets are tested via
# `bazel/` (`@envoy_toolshed_jq//...`, see `.github/workflows/bazel.yml`), so
# RBE (`rbe`/`bes`) config lives there, not here. This file is for local,
# standalone use of `jq/` only.
#############################################################################

#############################################################################
# global
#############################################################################

fetch --color=yes
run --color=yes
build --color=yes

common --registry=https://bcr.bazel.build/
common --registry=https://raw.githubusercontent.com/envoyproxy/bazel-registry/ae6ba630d46e4043c14da3ac5f7f823e6b6b469b
common --experimental_repository_cache_hardlinks

common --enable_platform_specific_config


#############################################################################
# ci
#############################################################################

common:ci --noshow_progress
common:ci --noshow_loading_progress
common:ci --test_output=errors


#############################################################################
# imports
#############################################################################

try-import %workspace%/repo.bazelrc
try-import %workspace%/user.bazelrc
